# ============================================================
# 弱信号分析 MCP Server — 环境变量配置模板
# 复制此文件为 .env 并填入你的实际配置
#   cp .env.example .env
# ============================================================

# --- LLM API 配置（必填） ---
# 支持 OpenAI 兼容接口（硅基流动、DeepSeek、讯飞MaaS 等）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# 各阶段使用的模型（可选，不设则使用 OPENAI_MODEL 或默认值）
# OPENAI_MODEL=Qwen/Qwen2.5-32B-Instruct
# EXTRACTION_MODEL=Qwen/Qwen2.5-14B-Instruct
# REPORT_MODEL=deepseek-ai/DeepSeek-V3

# --- 数据后端（可选） ---
# mock: 从 data/ 目录加载本地文件（默认）
# db:   从 MySQL + Elasticsearch 动态检索（需配置数据库连接）
WEAK_SIGNAL_DATA_BACKEND=mock

# --- 事件抽取（可选） ---
# EVENT_EXTRACTION_MAX_EVENTS_PER_DOC=6
# EVENT_EXTRACTION_MIN_CONFIDENCE=0
# EVENT_EXTRACTION_CONCURRENCY=2
# EVENT_EXTRACTION_BATCH_SIZE=5
# LLM_CLIENT_DEFAULT_TIMEOUT=120.0
